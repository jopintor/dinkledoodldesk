flowchart LR
    U(["User confirms the<br/>create_ticket card"]) --> S["DinkDesk backend<br/>saves ticket DD-xxxxxx"]
    S -->|"POST /ticket-created<br/>X-DinkDesk-Token"| W["n8n Webhook<br/>(Header Auth)"]
