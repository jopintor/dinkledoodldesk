# Copy to `.env` at the repo root and fill in real values. Never commit `.env`.
# The backend reads these when run locally; docker compose passes them to the
# containers (see infra/docker-compose.yml, which overrides the hostnames).

# --- App -------------------------------------------------------------------
# local | ci | demo
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=dinkdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dinkdesk
# Used when the backend runs outside Docker (compose overrides the host).
DATABASE_URL=postgresql+psycopg://dinkdesk:change-me@localhost:5432/dinkdesk

# --- ChromaDB --------------------------------------------------------------
CHROMA_HOST=localhost
# host port; inside compose it is chromadb:8000
CHROMA_PORT=8001
CHROMA_COLLECTION=picklehub-kb
# http = Chroma server above (compose) | persistent = embedded, stored in CHROMA_PERSIST_DIR
# (no Docker needed) | ephemeral = in memory
CHROMA_MODE=http
CHROMA_PERSIST_DIR=.chroma

# --- LLM provider ----------------------------------------------------------
# gemini (default, free tier) | openai | fake (offline, deterministic: tests and demos without a key)
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check the current free-tier model names in Google AI Studio before the demo.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Separate quota bucket; used when the primary is rate-limited or near its daily limit.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Changing the embedding model or dimension needs a re-index (new Chroma collection).
EMBEDDING_DIM=768
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800

# --- LLM gateway limits ----------------------------------------------------
# Our own ceilings, set a bit BELOW the free-tier quotas shown for your project in
# Google AI Studio (they change; check before the demo). See docs/architecture.md §5.
LLM_RPM_LIMIT=8
LLM_RPD_LIMIT=200
LLM_MAX_CONCURRENCY=2
LLM_QUEUE_MAX_WAIT_S=20
LLM_REQUEST_TIMEOUT_S=25
EMBEDDING_RPM_LIMIT=60

# --- RAG -------------------------------------------------------------------
# Confidence thresholds (answer >= HIGH, answer + offer ticket >= MEDIUM, else template).
RAG_HIGH_THRESHOLD=0.70
RAG_MEDIUM_THRESHOLD=0.50
RAG_COSINE_FLOOR=0.45
RAG_COSINE_CEILING=0.85
# Generated answers are cached here (relative to backend/); empty disables the cache.
RESPONSE_CACHE_PATH=.cache/response_cache.json
# true lets /rag/ask and /kb/search take the role from an X-Dev-Role header. Local dev only,
# until JWT auth is wired in. Never enable it on a shared or public host.
RAG_DEV_AUTH=false

# --- n8n -------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Where the backend sends automation webhooks (inside compose: http://n8n:5678)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# --- Jira Cloud (free tier) ------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ITH
