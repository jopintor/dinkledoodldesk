# Copy to `.env` at the repo root and fill in real values. Never commit `.env`.
# The backend reads these when run locally; docker compose passes them to the
# containers (see infra/docker-compose.yml, which overrides the hostnames).

# --- App -------------------------------------------------------------------
# local | ci | demo
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=dinkdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dinkdesk
# Used when the backend runs outside Docker (compose overrides the host).
DATABASE_URL=postgresql+psycopg://dinkdesk:change-me@localhost:5432/dinkdesk

# --- ChromaDB --------------------------------------------------------------
CHROMA_HOST=localhost
# host port; inside compose it is chromadb:8000
CHROMA_PORT=8001
CHROMA_COLLECTION=picklehub-kb

# --- LLM provider ----------------------------------------------------------
# gemini (default, free tier) | openai
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check the current free-tier model names in Google AI Studio before the demo.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2

# --- n8n -------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Where the backend sends automation webhooks (inside compose: http://n8n:5678)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# --- Jira Cloud (free tier) ------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ITH

# --- Auth ------------------------------------------------------------------
# Signs DinkDesk login tokens. Use a long random string outside local dev, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_MIN=60

# --- n8n <-> backend secrets -----------------------------------------------
# Header token the backend sends with every webhook to n8n.
N8N_WEBHOOK_TOKEN=change-me-n8n-webhook-token
# HMAC secret n8n uses to sign its callbacks to the backend.
N8N_CALLBACK_SECRET=change-me-n8n-callback-secret

# --- Mock StaffID directory (mock-directory/) -------------------------------
# Inside compose the backend uses http://mock-directory:8090 (compose overrides it).
DIRECTORY_BASE_URL=http://localhost:8090
# Shared by the backend and the mock directory (X-API-Key header).
DIRECTORY_API_KEY=dev-directory-key

# --- Email (Mailpit catches everything; inbox at http://localhost:8025) ----
# Inside compose the host is `mailpit` (compose overrides it).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=DinkDesk <dinkdesk@picklehub.example>

# --- Automation testing ----------------------------------------------------
# true = SLA reminders fire after 1 minute instead of 10 (demo rehearsals only).
SLA_TEST_MODE=false
