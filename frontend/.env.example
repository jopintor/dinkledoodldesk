# Copy to `.env.local` (gitignored) and pick ONE base URL. Restart `npm run dev` after changing it.

# Backend running on this machine (uvicorn or Docker):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# No backend at all — use the mock routes in src/app/mock-api:
# NEXT_PUBLIC_API_BASE_URL=/mock-api

# Jose's PC exposed through a tunnel (URL changes each time he starts it):
# NEXT_PUBLIC_API_BASE_URL=https://<something>.trycloudflare.com
